# NetOrchestra-SOC configuration template. Copy to .env and fill in.
# Do not commit .env. Secrets below are introduced in later phases and must be
# generated per-deployment (e.g. `openssl rand -base64 48`), never hardcoded.

# --- Backend (Phase 1) ---
NETO_BIND_ADDR=0.0.0.0:8080
NETO_LOG_JSON=false
RUST_LOG=info

# --- Worker (Phase 1) ---
NETO_BACKEND_URL=http://backend:8080
NETO_EVIDENCE_DIR=/var/lib/netorchestra/evidence
NETO_SSH_DIAL_TIMEOUT=10s
NETO_MAX_CAPTURE_SECS=3600

# --- Frontend dev (Phase 1) ---
VITE_BACKEND_URL=http://localhost:8080

# --- Database (Phase 2) ---
# [Fix #4] Generate a strong password with: openssl rand -base64 32 | tr -d '/+='
# Use ONLY alphanumeric characters to avoid URL-encoding issues in DATABASE_URL.
# Set POSTGRES_PASSWORD in .env — Compose and the entrypoint both REJECT the
# placeholder value "change-this-local-password" and "CHANGE_ME" at startup.
POSTGRES_PASSWORD=CHANGE_ME_generate_with_openssl_rand
POSTGRES_USER=netorchestra
POSTGRES_DB=netorchestra
# DATABASE_URL is assembled from the parts above by docker-compose.yml.
# If you set it manually, percent-encode special chars: @ → %40, # → %23, : → %3A, / → %2F
DATABASE_URL=postgres://netorchestra:CHANGE_ME_generate_with_openssl_rand@db:5432/netorchestra
NETO_DB_MAX_CONNECTIONS=10
NETO_DB_ACQUIRE_TIMEOUT_SECS=5
NETO_RUN_MIGRATIONS=true
# Set for Docker/CI builds that must compile without a live database.
SQLX_OFFLINE=true
# Used only by scripts/db-restore.sh (kept separate so a restore cannot hit the live DB by accident).
# TARGET_DATABASE_URL=
# BACKUP_DIR=./backups

# --- Authentication (Phase 3) ---
# REQUIRED. >= 32 bytes of randomness: openssl rand -base64 48
# The backend refuses to start with a short value or the CHANGE_ME placeholder.
NETO_JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_base64_48
NETO_JWT_ISSUER=netorchestra
NETO_JWT_AUDIENCE=netorchestra-api
NETO_ACCESS_TTL_SECS=900            # 15 minutes (allowed 60..3600)
NETO_REFRESH_TTL_SECS=604800        # 7 days (allowed 3600..2592000)
# Explicit frontend origin(s), comma-separated, no wildcards. Also used for the CSRF Origin check,
# so it must contain the origin your browser loads the UI from.
NETO_CORS_ORIGINS=http://localhost:5173
# Keep true in production (HTTPS). Set false ONLY for plain-http local development.
NETO_COOKIE_SECURE=true
# Public self-registration (creates VIEWER only). Keep false in production.
NETO_ALLOW_REGISTRATION=false
# One-time secret (>= 24 chars) that authorises creating the FIRST admin when the users table is
# empty. Send it as the X-Bootstrap-Token header; remove it after bootstrap.
NETO_BOOTSTRAP_TOKEN=
# Honour X-Forwarded-For (only behind a reverse proxy you control).
NETO_TRUST_PROXY=false
NETO_LOGIN_MAX_FAILURES=5
NETO_LOGIN_LOCK_SECS=900

# --- Forensics (Phases 4-7) ---
NETO_EVIDENCE_DIR=/var/lib/netorchestra/evidence     # original captures, written once, sealed 0400
NETO_WORKSPACE_DIR=/var/lib/netorchestra/workspace   # per-job scratch space, removed after each job
NETO_TSHARK_PATH=tshark
NETO_MAX_UPLOAD_BYTES=536870912                      # 512 MiB
NETO_MAX_CONCURRENT_JOBS=4
NETO_MAX_CAPTURE_SECS=3600
NETO_MAX_STREAM_BYTES=536870912                      # 512 MiB cap for one live capture
# Remote capture is OFF until BOTH are set:
# NETO_WORKER_BIN=/usr/local/bin/netorchestra-worker
# NETO_ALLOWED_TARGETS=10.20.0.0/16,192.0.2.10      # CIDR allow-list of hosts the server may SSH to
# Worker-side (read by the worker process, passed through by the backend):
# NETO_WORKER_KEYS_DIR=/run/secrets/ssh              # private keys named by credential_ref, mode 0600
# NETO_WORKER_KNOWN_HOSTS=/etc/netorchestra/known_hosts

# --- Reserved for later phases (do not set real values here) ---
